# Runtime data
datasets/
output/
*.log

# Retired local application artifacts must never re-enter the native source.
desktop_app/
.playwright-cli/

# Release artifacts
*.zip
*.zip.bak-*
*.exe
*.pak
*.dll
*.bin
*.dat
release/

# Downloaded third-party binaries/caches at repository root
/third_party/
!/third_party/.gitkeep

# Generated dependency caches (including remnants of retired checkouts)
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.jobs/

# Local conda/cache directories that can appear under gaussian-splatting
.cache/
.conda_envs/
.conda_pkgs/
.home/
.localappdata/
.tmp/

# Build intermediates
native/.deps/
build/
build-*/
dist/
*.obj
*.exp
*.lib
*.pdb
gaussian-splatting/gsw_loss_cuda/build/
gaussian-splatting/gsw_loss_cuda/*.egg-info/
